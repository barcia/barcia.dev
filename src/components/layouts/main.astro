---
import { ClientRouter } from "astro:transitions";
import "@/assets/styles/global.css";
import { Font } from "astro:assets";
import { Footer, Navbar } from "@/components/sections";

const { class: className } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Iván Barcia | UI Engineer</title>
		<meta
			name="description"
			content="Iván Barcia is a UI Engineer and Frontend Developer based in Santiago de Compostela, Spain."
		/>
		<meta name="format-detection" content="telephone=no" />
		<ClientRouter />
		<Font cssVariable="--font-inter" />
	</head>
	<body
		class="mx-auto box-content flex min-h-dvh max-w-3xl cursor-default flex-col bg-white px-4 font-sans text-gray-900 antialiased md:px-8 dark:bg-zinc-900 dark:text-gray-50"
	>
		<Navbar />
		<main class:list={["mx-auto w-full flex-1", className]}>
			<slot />
		</main>
		<Footer />
	</body>
</html>
