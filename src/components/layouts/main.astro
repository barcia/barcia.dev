---
import { ClientRouter } from "astro:transitions";
import "@/assets/styles/global.css";
import { Font } from "astro:assets";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { Footer, Navbar } from "@/components/sections";
import { DEFAULT_LOCALE, getLocale, LOCALES, stripLocale, useTranslations } from "@/i18n";

const { class: className } = Astro.props;

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const path = stripLocale(Astro.url.pathname);
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{t("meta.title")}</title>
		<meta name="description" content={t("meta.description")} />
		<link rel="canonical" href={getAbsoluteLocaleUrl(locale, path)} />
		{
			LOCALES.map((alternate) => (
				<link rel="alternate" hreflang={alternate} href={getAbsoluteLocaleUrl(alternate, path)} />
			))
		}
		<link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(DEFAULT_LOCALE, path)} />
		<meta name="format-detection" content="telephone=no" />
		<ClientRouter />
		<Font cssVariable="--font-inter" />
	</head>
	<body
		class="mx-auto box-content flex min-h-dvh max-w-3xl cursor-default flex-col bg-white px-4 font-sans text-gray-900 antialiased md:px-8 dark:bg-zinc-900 dark:text-gray-50"
	>
		<Navbar />
		<main class:list={["mx-auto w-full flex-1", className]}>
			<slot />
		</main>
		<Footer />
	</body>
</html>
