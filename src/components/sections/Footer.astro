---
import { NAV_FOOTER } from "@/site.config";

const { pathname } = Astro.url;

const isActive = (url: string) => pathname.split("/")[1] === url.split("/")[1];
---

<footer class="mt-16 py-8 text-xs md:mt-32">
	<div class="flex flex-col-reverse justify-between gap-3 md:flex-row">
		<div class="">© 2026 HOB • handcrafting the web</div>
		<ul class="flex gap-8">
			{
				NAV_FOOTER.map((item) => (
					<li>
						<a href={item.url} class:list={["no-underline", { "font-bold": isActive(item.url) }]}>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</footer>
